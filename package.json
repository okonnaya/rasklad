{
  "name": "rasklad",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okonnaya/rasklad.git"
  },
  "bugs": {
    "url": "https://github.com/okonnaya/rasklad/issues"
  },
  "homepage": "https://raskladik.com",
  "scripts": {
    "prestart": "npm run db:export",
    "prewatch": "npm run db:export",
    "prebuild": "npm run db:export",
    "db:seed": "python3 scripts/content_db.py seed",
    "db:export": "python3 scripts/content_db.py export",
    "db:import": "python3 scripts/content_db.py import-airtable",
    "db:status": "python3 scripts/content_db.py status",
    "test:db": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "start": "webpack serve --open --config webpack.dev.js",
    "watch": "webpack --watch --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "lint": "eslint src scripts build tests webpack.*.js eslint.config.js",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"{build,scripts,tests}/**/*.{js,cjs,mjs}\" \"webpack.*.js\" eslint.config.js",
    "test:js": "node --test tests/*.test.cjs",
    "test": "npm run test:js && npm run test:db",
    "check": "npm run lint && npm test && npm run build && npm run check:build",
    "check:build": "node scripts/check-build.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.2",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^17.12.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "description": "Медиа о таро «Расклад»",
  "engines": {
    "node": ">=22.15.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
